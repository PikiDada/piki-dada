# Variables read by docker-compose.yml itself (as opposed to apps/api/.env, which is the
# NestJS app's own config, loaded separately via env_file). On the shared server this is
# /srv/apps/pikidada/.env; deploy with the box's `bin/deploy.sh pikidada`.

# The password of the `pikidada` database login, printed once by the box's
# `bin/add-app.sh pikidada`. The maps platform uses it; apps/api/.env's DATABASE_URL has it too.
PIKIDADA_DB_PASSWORD=""


# Optional parts of docker-compose.yml to run. Set to "routing" once OSRM's map data is
# prepared (see the comment on the osrm service); until then OSRM stays off.
COMPOSE_PROFILES=""

# Shared secret between the API and the maps platform (services/maps). Any long random
# string, e.g. `openssl rand -hex 32`.
MAPS_PLATFORM_TOKEN=""

# Baked into the web app at build time (Next.js NEXT_PUBLIC_* vars are inlined into the
# JS bundle during `docker compose build`, not read at runtime) — must match apps/api/.env's
# CORS_ORIGIN/public URL for the API.
NEXT_PUBLIC_API_URL="https://api.pikidada.com"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Map display switch, also baked in at build time; leave empty for Google. See "Our own map
# display" in deploy/README.md and apps/web/.env.example.
NEXT_PUBLIC_MAP_PROVIDER=""
NEXT_PUBLIC_MAP_TILES_URL=""
NEXT_PUBLIC_MAP_GLYPHS_URL=""
NEXT_PUBLIC_MAP_SPRITE_URL=""
