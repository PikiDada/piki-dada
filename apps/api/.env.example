# Self-hosted Postgres (docker-compose service name "postgres"), no TLS needed on the
# private Docker network. For a managed/remote Postgres instead, add ?sslmode=require.
DATABASE_URL="postgresql://user:password@postgres:5432/pikidada"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="900"
JWT_REFRESH_EXPIRES_IN="604800"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4001/auth/google/callback"
# Server-side key for Routes API (real road distance/duration for fares) --
# separate from the browser-facing Maps key. Optional: if unset, fare
# distance falls back to a straight-line estimate rather than failing.
GOOGLE_ROUTES_API_KEY=""
PORT=4001
CORS_ORIGIN="http://localhost:3000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
# Email via the self-hosted Postfix container (docker-compose service "postfix", the
# boky/postfix image -- listens on submission port 587, no host port mapping needed since
# only the api container talks to it, over the private Docker network).
# Without SMTP_HOST, EmailService silently disables itself: welcome/verification/
# password-reset/receipt emails are logged to the console and never sent, with no error
# surfaced anywhere. SMTP_USER/SMTP_PASSWORD are left blank -- boky/postfix trusts the
# Docker network by default (see POSTFIX_mynetworks in docker-compose.yml), no auth needed.
# For deliverability, SMTP_FROM_EMAIL's domain needs SPF/DKIM/DMARC DNS records and the
# server's rDNS/PTR set to match (see the migration plan) -- without those, most providers
# will spam-box or reject the mail outright.
SMTP_HOST="postfix"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="Piki Dada <noreply@pikidada.com>"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Web push (VAPID) — required, app crashes on boot if missing. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@pikidada.app"
# Used once by `pnpm db:seed` to bootstrap the first admin account (self-registering as
# ADMIN through the public API is blocked by design). Leave unset to skip.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Error tracking — leave unset to skip (errors still get logged to stdout via Logger).
SENTRY_DSN=""
# AES-256-GCM key for app-level field encryption (currently just User.phone). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Free to generate, no vendor needed — but once set, never change it without first
# decrypting and re-encrypting existing data, or those rows become unreadable.
FIELD_ENCRYPTION_KEY=""
# MinIO (S3-compatible) for file uploads (driver documents storage), docker-compose service
# "minio". MINIO_ENDPOINT is what the API uses to reach it over the private Docker network.
# MINIO_PUBLIC_URL is what gets embedded in returned file URLs for browsers to fetch directly
# (the admin UI loads document previews as <img src>) — routed through Caddy at
# files.pikidada.com (see Caddyfile), which needs its own DNS A record pointed at the server.
# MINIO_ACCESS_KEY/MINIO_SECRET_KEY should match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD set for
# the minio service in docker-compose.yml.
MINIO_ENDPOINT="http://minio:9000"
MINIO_PUBLIC_URL="https://files.pikidada.com"
MINIO_BUCKET="driver-documents"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
