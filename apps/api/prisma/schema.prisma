generator client {
  provider = "prisma-client-js"
}

// Migrations take Postgres advisory locks, which a transaction-mode pooler (Supabase port
// 6543, PgBouncer) can't hold: `migrate deploy` hangs. DIRECT_URL is a connection that can
// (Supabase's session pooler on 5432, or the same as DATABASE_URL for a self-hosted server).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum RideType {
  ECONOMY
  COMFORT
  BODA
}

enum TripStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Two "arrived" states (unlike TripStatus) because a delivery rider visits two distinct
// places for two distinct events -- collecting the item, then handing it off -- where a ride
// just starts once the passenger is in the vehicle.
enum DeliveryStatus {
  REQUESTED
  SEARCHING
  ACCEPTED
  ARRIVED_PICKUP
  PICKED_UP
  ARRIVED_DROPOFF
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  STRIPE
  FLUTTERWAVE
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  NATIONAL_ID
  DRIVING_PERMIT
  VEHICLE_REGISTRATION
  INSURANCE
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  name                String
  phone               String?
  photoUrl            String?
  fcmToken            String?
  role                UserRole
  isActive            Boolean   @default(true)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  driverProfile      Driver?
  savedPlaces        SavedPlace[]
  passengerTrips     Trip[]              @relation("PassengerTrips")
  sentDeliveries     Delivery[]          @relation("SentDeliveries")
  emergencyContact   EmergencyContact[]
  wallet             Wallet?
  ratingsGiven       Rating[]            @relation("RatingsGiven")
  ratingsReceived    Rating[]            @relation("RatingsReceived")
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  pushSubscriptions  PushSubscription[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model VerificationToken {
  id        String                   @id @default(cuid())
  token     String                   @unique
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model EmergencyContact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  phone  String
}

model Driver {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalStatus DriverApprovalStatus @default(PENDING)
  isOnline       Boolean              @default(false)
  currentLat     Float?
  currentLng     Float?
  rating         Float                @default(5.0)
  totalTrips     Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  vehicle    Vehicle?
  documents  Document[]
  trips      Trip[]     @relation("DriverTrips")
  deliveries Delivery[] @relation("RiderDeliveries")
}

model Vehicle {
  id          String   @id @default(cuid())
  driverId    String   @unique
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make        String
  model       String
  color       String
  plateNumber String   @unique
  rideType    RideType
  photoUrl    String?
  createdAt   DateTime @default(now())
}

model Document {
  id         String       @id @default(cuid())
  driverId   String
  driver     Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileUrl    String
  uploadedAt DateTime     @default(now())
}

model Trip {
  id                 String        @id @default(cuid())
  passengerId        String
  passenger          User          @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId           String?
  driver             Driver?       @relation("DriverTrips", fields: [driverId], references: [id])
  status             TripStatus    @default(REQUESTED)
  rideType           RideType
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float?
  durationMin        Float?
  // Ground truth, computed from locationPings once the trip reaches COMPLETED -- distanceKm/
  // durationMin above are the pre-trip ESTIMATE used for pricing, these are what actually
  // happened. Null until completion, and also null if too few pings were recorded to measure
  // (e.g. the driver app was backgrounded). The gap between estimate and actual is what lets
  // pricing self-calibrate over time instead of relying on a fixed fallback factor forever.
  actualDistanceKm   Float?
  actualDurationMin  Float?
  // Charged for time the driver waits at stops beyond the free allowance, and already folded
  // into `fare` once the trip completes -- kept separately so the passenger can see why the
  // final fare is higher than the quote. Payments read `fare`, never this.
  waitingFee         Float         @default(0)
  // The waiting rates in force when the trip was booked, so an admin changing them mid-trip
  // doesn't change what this passenger agreed to.
  waitingPerMinute   Float         @default(0)
  freeWaitMinutes    Int           @default(3)
  fare               Float?
  currency           String        @default("UGX")
  couponCode         String?
  paymentMethod      PaymentMethod
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  // Plain id, not a relation -- it's an attribution field (who actually cancelled: the
  // passenger or the driver), not a navigable relationship, so it doesn't need a User.trips
  // back-reference the way passengerId/driverId do. Used to tell a passenger who cancels their
  // own requests (the thing that racks up billable Google Routes API calls for nothing) apart
  // from a driver backing out after accepting, which doesn't trigger a new API call.
  cancelledByUserId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payment       Payment?
  ratings       Rating[]
  locationPings TripLocationPing[]
  stops         TripStop[]

  @@index([cancelledByUserId, cancelledAt])
}

// Intermediate stops between pickup and destination, visited in `sequence` order. A stop the
// driver has already arrived at is locked: mid-trip edits only replace stops not yet reached.
model TripStop {
  id         String    @id @default(cuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence   Int
  address    String
  lat        Float
  lng        Float
  arrivedAt  DateTime?
  departedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tripId, sequence])
}

// Raw GPS trace recorded only while a trip is IN_PROGRESS -- not during the driver's approach
// to pickup, which isn't part of what the passenger is billed for. This is the ground-truth
// trajectory behind Trip.actualDistanceKm/actualDurationMin, and is kept even after those are
// computed: a future map-matching step (snapping pings to actual OSM road segments to learn
// real travel speeds per road, rather than just a straight-line sum between pings) needs the
// raw points, not just the derived totals. Never exposed directly via the API.
model TripLocationPing {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
}

model Payment {
  id          String        @id @default(cuid())
  tripId      String        @unique
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        @default("UGX")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Deliveries are a parallel offering to Trip/Payment above, not a generalization of them --
// kept as separate models so this real-money code never touches the existing ride-payment
// flow. Same riders (Driver) accept both; a delivery always matches BODA-vehicle riders only.
model Delivery {
  id                   String            @id @default(cuid())
  senderId             String
  sender               User              @relation("SentDeliveries", fields: [senderId], references: [id])
  riderId              String?
  rider                Driver?           @relation("RiderDeliveries", fields: [riderId], references: [id])
  categoryId           String
  category             DeliveryCategory  @relation(fields: [categoryId], references: [id])
  // Nullable at the DB level (not backfilled for any pre-existing test rows), but required by
  // the request DTO for every new delivery -- see RequestDeliveryDto. This is what actually
  // drives the fare now; category is purely descriptive (see DeliveryCategory's comment).
  sizeTierId           String?
  sizeTier             DeliverySizeTier? @relation(fields: [sizeTierId], references: [id])
  status               DeliveryStatus    @default(REQUESTED)
  pickupContactName    String
  pickupContactPhone   String
  pickupAddress        String
  pickupLat            Float
  pickupLng            Float
  dropoffContactName   String
  dropoffContactPhone  String
  destinationAddress   String
  destinationLat       Float
  destinationLng       Float
  itemDescription      String
  itemPhotoUrl         String?
  isFragile            Boolean           @default(false)
  isLiquid             Boolean           @default(false)
  cashOnDeliveryAmount Float?
  distanceKm           Float?
  durationMin          Float?
  // Same as Trip.waitingFee / waitingPerMinute / freeWaitMinutes -- see their comments.
  waitingFee           Float             @default(0)
  waitingPerMinute     Float             @default(0)
  freeWaitMinutes      Int               @default(3)
  fare                 Float?
  currency             String            @default("UGX")
  paymentMethod        PaymentMethod
  acceptedAt           DateTime?
  arrivedPickupAt      DateTime?
  pickedUpAt           DateTime?
  arrivedDropoffAt     DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  // Same attribution field as Trip.cancelledByUserId -- see its comment.
  cancelledByUserId    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  payment DeliveryPayment?
  stops   DeliveryStop[]

  @@index([cancelledByUserId, cancelledAt])
}

// Extra drop-offs visited, in `sequence` order, after pickup and before the final drop-off
// stored on Delivery itself. Each has its own recipient. Same locking rule as TripStop.
model DeliveryStop {
  id           String    @id @default(cuid())
  deliveryId   String
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sequence     Int
  address      String
  lat          Float
  lng          Float
  contactName  String
  contactPhone String
  arrivedAt    DateTime?
  departedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([deliveryId, sequence])
}

model DeliveryPayment {
  id          String        @id @default(cuid())
  deliveryId  String        @unique
  delivery    Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        @default("UGX")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  currency  String   @default("UGX")
  updatedAt DateTime @updatedAt

  ledgerEntries WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  createdAt DateTime @default(now())
}

model Rating {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingsReceived", fields: [toUserId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountAmount  Float?
  discountPercent Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model PricingRule {
  id               String   @id @default(cuid())
  rideType         RideType @unique
  baseFare         Float
  perKm            Float
  perMinute        Float
  // Waiting at stops: free for freeWaitMinutes per stop, then waitingPerMinute. Separate from
  // perMinute (driving time) so admins can price a driver's idle wait on its own terms.
  waitingPerMinute Float    @default(0)
  freeWaitMinutes  Int      @default(3)
  currency         String   @default("UGX")
  updatedAt        DateTime @updatedAt
}

enum UnvisitedStopsPolicy {
  // Re-price without the stops never reached (never above the quote).
  REMOVE_FROM_FARE
  // Keep the quoted fare.
  CHARGE_QUOTED
}

// App-wide pricing settings, one row (id 1), edited from /admin/pricing. Per-ride-type and
// per-delivery-tier rates live on PricingRule / DeliverySizeTierPricingRule instead.
model PricingSettings {
  id                         Int                  @id @default(1)
  // Every fare is rounded to this many UGX, so cash fares are payable in notes.
  fareRoundingUnit           Int                  @default(500)
  // Share of each paid fare the platform keeps; the rider earns the rest.
  platformCommissionRate     Float                @default(0.15)
  unvisitedStopsPolicy       UnvisitedStopsPolicy @default(REMOVE_FROM_FARE)
  // Used only when no routing service answers: road distance = straight line x this factor,
  // and duration (and rider ETAs) from this average speed.
  roadDistanceFallbackFactor Float                @default(1.3)
  averageSpeedKmh            Float                @default(28)
  updatedAt                  DateTime             @updatedAt
}

// Categories are admin-managed data, not a fixed enum, so new ones (e.g. "Medicine",
// "Flowers") can be added from /admin/delivery-categories without a code deploy -- the
// defining constraint for what's deliverable is "fits on a motorcycle," not the item type.
// Purely descriptive: what the item is, for the rider's handling instructions. Price is driven
// by DeliverySizeTier below instead -- a "Parcel" and a 50kg cargo item aren't the same price
// just because they're filed under the same category.
model DeliveryCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  Delivery[]
  pricingRule DeliveryPricingRule?
}

// Superseded by DeliverySizeTierPricingRule below -- left in place (unused) rather than
// dropped, so no data is destroyed. /admin/delivery-categories no longer exposes pricing.
model DeliveryPricingRule {
  id         String           @id @default(cuid())
  categoryId String           @unique
  category   DeliveryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  baseFare   Float
  perKm      Float
  perMinute  Float
  currency   String           @default("UGX")
  updatedAt  DateTime         @updatedAt
}

// How hard the item is to carry -- this is what actually prices a delivery, independent of
// category. Admin-managed data for the same reason categories are: e.g. "Small parcel (up to
// 5kg)", "Medium (5-20kg)", "Large/Cargo (20-50kg)", "Heavy (50kg+)".
model DeliverySizeTier {
  id          String   @id @default(cuid())
  name        String   @unique
  maxWeightKg Float?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  Delivery[]
  pricingRule DeliverySizeTierPricingRule?
}

model DeliverySizeTierPricingRule {
  id               String           @id @default(cuid())
  sizeTierId       String           @unique
  sizeTier         DeliverySizeTier @relation(fields: [sizeTierId], references: [id], onDelete: Cascade)
  baseFare         Float
  perKm            Float
  perMinute        Float
  // Same as PricingRule's waiting fields.
  waitingPerMinute Float            @default(0)
  freeWaitMinutes  Int              @default(3)
  currency         String           @default("UGX")
  updatedAt        DateTime         @updatedAt
}

// Flat handling surcharges for delicate/awkward items -- a small table instead of hardcoded
// numbers so admin can tune the amount (or add a third key later via one seed row) without a
// deploy. Exactly FRAGILE and LIQUID exist for now; admin edits amounts, doesn't create new
// ones yet.
model DeliverySurchargeRule {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  amount    Float
  currency  String   @default("UGX")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PushBroadcastLog {
  id          String   @id @default(cuid())
  title       String
  body        String
  url         String?
  sentCount   Int
  failedCount Int
  createdAt   DateTime @default(now())
}
